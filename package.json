{
  "name": "game-shelf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "npm --prefix web ci",
    "build": "npm --prefix web run build",
    "start": "npm run build && go run ./cmd/gameshelf serve",
    "serve": "go run ./cmd/gameshelf serve",
    "sync": "go run ./cmd/gameshelf sync",
    "covers": "go run ./cmd/gameshelf covers",
    "dev": "npm --prefix web run dev",
    "test": "go test ./... && npm run build"
  }
}
